{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "忆涟千言",
  "version": "1.2.0",
  "identifier": "com.yilianqianyan.desktop",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm --prefix ./frontend run build",
    "beforeDevCommand": "npm --prefix ./frontend run dev"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "忆涟千言",
        "width": 1440,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "visible": false,
        "dragDropEnabled": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "../skills/code-reviewer/": "bundled-skills/code-reviewer/",
      "../skills/doc-writer/": "bundled-skills/doc-writer/",
      "../skills/python-expert/": "bundled-skills/python-expert/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.15",
      "exceptionDomain": "",
      "signingIdentity": null,
      "entitlements": null,
      "providerShortName": null
    }
  }
}
